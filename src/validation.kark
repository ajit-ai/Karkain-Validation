// Karkain-Validation - reusable data and rule validation.
// Compatible with Karkain Language v1.2.0 (verified tag v1.2.0,
// commit 77d70693e1e3134dac312a303bffafa7d50fa988).
//
// Representation convention (top-level structs are unavailable in the
// stable v1.2.0 subset): a validation report is a flat mixed array of
// error triples:
//
//     [field, rule, message, field, rule, message, ...]
//
// An empty report means validation succeeded. Arrays are values in
// Karkain, so every function returns the updated report and callers must
// capture it: report = validation.required(report, "name", name).
//
// Comparison expressions in v1.2.0 produce integer 1/0 results. Truth
// checks use `if ok` / `if ok == false` consistently; no type-specific
// boolean assumptions are made.

// new_report returns an empty validation report.
public func new_report() {
    return []
}

// add_error appends one diagnostic triple to a report.
public func add_error(report, field, rule, message) {
    let out = report
    out = push(out, field)
    out = push(out, rule)
    out = push(out, message)
    return out
}

// expect is the generic rule primitive. It adds an error when ok is false
// and otherwise returns the report unchanged. All rules build on it.
public func expect(report, field, rule, ok, message) {
    if ok {
        return report
    }
    return add_error(report, field, rule, message)
}

// error_count returns the number of recorded validation errors.
public func error_count(report) {
    return len(report) / 3
}

// is_valid reports whether the validation produced no errors.
public func is_valid(report) {
    return error_count(report) == 0
}

// error_field returns the field name of the nth error.
public func error_field(report, n) {
    return report[n * 3]
}

// error_rule returns the rule name of the nth error.
public func error_rule(report, n) {
    return report[n * 3 + 1]
}

// error_message returns the diagnostic message of the nth error.
public func error_message(report, n) {
    return report[n * 3 + 2]
}

// field_error_count counts errors recorded for one named field.
public func field_error_count(report, field) {
    let n = 0
    let i = 0
    while (i < len(report)) {
        if report[i] == field {
            n = n + 1
        }
        i = i + 3
    }
    return n
}

// merge_reports combines two reports into one, preserving order.
public func merge_reports(a, b) {
    let out = a
    let i = 0
    while (i < len(b)) {
        out = push(out, b[i])
        i = i + 1
    }
    return out
}

// required checks that a string or array value is non-empty. Numeric
// values should use require_nonzero instead; len(number) is 0 in v1.2.0.
public func required(report, field, value) {
    let ok = len(value) > 0
    let message = field + " is required"
    return expect(report, field, "required", ok, message)
}

// require_nonzero checks that a numeric value is not zero.
public func require_nonzero(report, field, value) {
    let ok = value != 0
    let message = field + " must be non-zero"
    return expect(report, field, "nonzero", ok, message)
}

// empty checks that a string or array value is empty.
public func empty(report, field, value) {
    let ok = len(value) == 0
    let message = field + " must be empty"
    return expect(report, field, "empty", ok, message)
}

// min_value checks value >= minimum.
public func min_value(report, field, value, minimum) {
    let ok = value >= minimum
    let message = field + " must be >= " + str(minimum)
    return expect(report, field, "min", ok, message)
}

// max_value checks value <= maximum.
public func max_value(report, field, value, maximum) {
    let ok = value <= maximum
    let message = field + " must be <= " + str(maximum)
    return expect(report, field, "max", ok, message)
}

// min_length checks len(value) >= minimum.
public func min_length(report, field, value, minimum) {
    let ok = len(value) >= minimum
    let message = field + " length must be >= " + str(minimum)
    return expect(report, field, "min_length", ok, message)
}

// max_length checks len(value) <= maximum.
public func max_length(report, field, value, maximum) {
    let ok = len(value) <= maximum
    let message = field + " length must be <= " + str(maximum)
    return expect(report, field, "max_length", ok, message)
}

// in_range checks minimum <= value <= maximum using explicit branches;
// logical `and` is not available in the verified stable subset.
public func in_range(report, field, value, minimum, maximum) {
    if value < minimum {
        let message = field + " must be >= " + str(minimum)
        return add_error(report, field, "range", message)
    }
    if value > maximum {
        let message = field + " must be <= " + str(maximum)
        return add_error(report, field, "range", message)
    }
    return report
}

// length_range checks minimum <= len(value) <= maximum.
public func length_range(report, field, value, minimum, maximum) {
    let size = len(value)
    if size < minimum {
        let message = field + " length must be >= " + str(minimum)
        return add_error(report, field, "length_range", message)
    }
    if size > maximum {
        let message = field + " length must be <= " + str(maximum)
        return add_error(report, field, "length_range", message)
    }
    return report
}

// is_digits reports whether a non-empty string contains only ASCII digits.
// Character classification uses the verified `contains` builtin over a
// literal alphabet; no unsupported regex or Unicode API is assumed.
public func is_digits(value) {
    let n = len(value)
    if n == 0 {
        return false
    }
    let i = 0
    while (i < n) {
        if contains("0123456789", value[i]) == false {
            return false
        }
        i = i + 1
    }
    return true
}

// is_alpha reports whether a non-empty string contains only ASCII letters.
public func is_alpha(value) {
    let n = len(value)
    if n == 0 {
        return false
    }
    let i = 0
    while (i < n) {
        if contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ", value[i]) == false {
            return false
        }
        i = i + 1
    }
    return true
}

// is_alphanumeric reports whether a non-empty string contains only ASCII
// letters or digits.
public func is_alphanumeric(value) {
    let n = len(value)
    if n == 0 {
        return false
    }
    let i = 0
    while (i < n) {
        if contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789", value[i]) == false {
            return false
        }
        i = i + 1
    }
    return true
}

// is_email_basic performs a deliberately simple structural check: a
// non-empty string containing '@' and '.', not starting or ending with
// '@', and longer than four characters. It is not RFC 5322 validation.
public func is_email_basic(value) {
    let n = len(value)
    if n <= 4 {
        return false
    }
    if contains(value, "@") == false {
        return false
    }
    if contains(value, ".") == false {
        return false
    }
    if value[0] == "@" {
        return false
    }
    if value[n - 1] == "@" {
        return false
    }
    return true
}

// format applies a named built-in format validator. Supported names are
// "digits", "alpha", "alphanumeric" and "email". Unknown names record an
// error with rule "format" rather than being silently accepted.
public func format(report, field, value, format_name) {
    if format_name == "digits" {
        return expect(report, field, "format", is_digits(value), field + " must contain digits only")
    }
    if format_name == "alpha" {
        return expect(report, field, "format", is_alpha(value), field + " must contain letters only")
    }
    if format_name == "alphanumeric" {
        return expect(report, field, "format", is_alphanumeric(value), field + " must contain letters or digits only")
    }
    if format_name == "email" {
        return expect(report, field, "format", is_email_basic(value), field + " must be a basic email address")
    }
    let message = field + " has unknown format " + format_name
    return add_error(report, field, "format", message)
}

// custom_rule invokes an application-defined predicate result. The caller
// writes the predicate in Karkain and passes its 1/0 result here; no
// function-pointer or dynamic-dispatch feature is assumed.
public func custom_rule(report, field, rule_name, ok) {
    let message = field + " failed custom rule " + rule_name
    return expect(report, field, rule_name, ok, message)
}

// custom_rule_message is the custom rule form with an explicit diagnostic.
public func custom_rule_message(report, field, rule_name, ok, message) {
    return expect(report, field, rule_name, ok, message)
}

// validate_required_all applies the required rule to parallel arrays of
// field names and values. A length mismatch is itself recorded as an error
// so invalid input is handled predictably.
public func validate_required_all(report, fields, values) {
    if len(fields) != len(values) {
        return add_error(report, "fields", "input", "field and value counts differ")
    }
    let out = report
    let i = 0
    while (i < len(fields)) {
        out = required(out, fields[i], values[i])
        i = i + 1
    }
    return out
}

// validate_range_all applies in_range to parallel arrays of field names
// and numeric values.
public func validate_range_all(report, fields, values, minimum, maximum) {
    if len(fields) != len(values) {
        return add_error(report, "fields", "input", "field and value counts differ")
    }
    let out = report
    let i = 0
    while (i < len(fields)) {
        out = in_range(out, fields[i], values[i], minimum, maximum)
        i = i + 1
    }
    return out
}

// summarize builds a one-line validation summary.
public func summarize(title, report) {
    return title + ": " + str(error_count(report)) + " validation error(s)"
}

// print_report prints a summary and every recorded diagnostic, then
// returns overall validation status.
public func print_report(title, report) {
    println(summarize(title, report))
    let i = 0
    while (i < error_count(report)) {
        println(error_field(report, i) + " [" + error_rule(report, i) + "] " + error_message(report, i))
        i = i + 1
    }
    return is_valid(report)
}
